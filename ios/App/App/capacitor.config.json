      "glob",
      "happy-dom",
      "lucide-react",
      "magic-string",
      "plist",
      "react",
      "react-big-calendar",
      "react-day-picker",
      "react-dom",
      "react-helmet",
      "react-helmet-async",
      "react-hook-form",
      "react-resizable-panels",
      "react-router-dom",
      "recharts",
      "sharp",
      "sonner",
      "superjson",
      "vite",
      "vite-plugin-minify",
      "vite-plugin-node-polyfills",
      "vite-plugin-optimize-css-modules",
