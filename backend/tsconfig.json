{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "preserve", "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "types": ["node"], "noEmit": true
  },
  "include": ["helpers/**/*", "endpoints/**/*", "runtime/**/*"],
  "exclude": ["helpers/*.spec.tsx"]
}
