{
  "name": "muwa-backend",
  "private": true,
  "scripts": {
    "test": "node tests/run_checks.cjs",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "schema:generate": "kysely-codegen --camel-case --dialect postgres --url 'env(MUWA_DATABASE_URL)' --out-file helpers/schema.tsx",
    "owner:prepare": "node scripts/bootstrap-owner.mjs",
    "test:runtime": "node scripts/runtime-checks.mjs"
  },
  "devDependencies": {
    "jasmine": "7.0.0",
    "pg": "8.16.3",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "esbuild": "0.28.2",
    "kysely-codegen": "0.20.0",
    "@types/node": "^22.0.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "kysely": "0.29.6",
    "kysely-postgres-js": "^5.0.1",
    "postgres": "^3.4.9",
    "superjson": "2.2.6",
    "zod": "^3.25.76",
    "hono": "4.13.13",
    "@hono/node-server": "2.1.3",
    "jose": "6.2.12",
    "bcryptjs": "3.0.3"
  }
}
